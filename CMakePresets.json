{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2026-x64",
      "displayName": "Visual Studio Build Tools 2026 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/vs2026-x64",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/package/VizRack",
        "VIZRACK_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
